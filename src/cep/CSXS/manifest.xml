<?xml version="1.0" encoding="UTF-8"?>
<!-- Chandelier panel (CEP). Illustrator 2021 (25) and later; CEP 9+ (CSXS 9.0). Unsigned: needs PlayerDebugMode
     (scripts/cep/install.mjs sets it). Window > Extensions > Chandelier opens it. -->
<ExtensionManifest Version="7.0" ExtensionBundleId="io.github.acidka.chandelier" ExtensionBundleVersion="0.5.2"
  ExtensionBundleName="Chandelier" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="io.github.acidka.chandelier.panel" Version="0.5.2" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="ILST" Version="[25.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="io.github.acidka.chandelier.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Chandelier</Menu>
          <Geometry>
            <Size><Height>320</Height><Width>280</Width></Size>
            <MinSize><Height>160</Height><Width>200</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
